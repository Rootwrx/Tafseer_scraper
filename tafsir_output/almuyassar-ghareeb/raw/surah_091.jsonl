{"src": "almuyassar-ghareeb", "s": 91, "a_start": 1, "a_end": 1, "data": "﴿وَضُحَىٰهَا﴾: أقْسَمَ اللهُ بإشْراقِ الشَّمْسِ ضُحىً."}
{"src": "almuyassar-ghareeb", "s": 91, "a_start": 2, "a_end": 2, "data": "﴿تَلَىٰهَا﴾: تَبِعَها في الطُّلُوعِ والأُفُول."}
{"src": "almuyassar-ghareeb", "s": 91, "a_start": 3, "a_end": 3, "data": "﴿جَلَّىٰهَا﴾: جَلّى الظُّلْمةَ وكَشَفَها."}
{"src": "almuyassar-ghareeb", "s": 91, "a_start": 4, "a_end": 4, "data": "﴿يَغۡشَىٰهَا﴾: يُغَطِّي الأَرْضَ فيكُونُ ما عَلَيها مُظْلِمًا."}
{"src": "almuyassar-ghareeb", "s": 91, "a_start": 5, "a_end": 5, "data": "﴿وَمَا بَنَىٰهَا﴾: وبِنائِها المُحْكَمِ."}
{"src": "almuyassar-ghareeb", "s": 91, "a_start": 6, "a_end": 6, "data": "﴿وَمَا طَحَىٰهَا﴾: وبَسْطِها."}
{"src": "almuyassar-ghareeb", "s": 91, "a_start": 7, "a_end": 7, "data": "﴿وَمَا سَوَّىٰهَا﴾: وإكْمالِ اللهِ خَلْقَها لأداءِ مُهِمَّتِها."}
{"src": "almuyassar-ghareeb", "s": 91, "a_start": 8, "a_end": 8, "data": "﴿فَأَلۡهَمَهَا﴾: فَبيَّنَ لَها.\n﴿فُجُورَهَا﴾: طَرِيقَ الشَّرِّ.\n﴿وَتَقۡوَىٰهَا﴾: وطَرِيقَ الخيرِ."}
{"src": "almuyassar-ghareeb", "s": 91, "a_start": 9, "a_end": 9, "data": "﴿أَفۡلَحَ﴾: فاز.\n﴿زَكَّىٰهَا﴾: طَهَّرَها، ونَمّاها بالخيرِ."}
{"src": "almuyassar-ghareeb", "s": 91, "a_start": 10, "a_end": 10, "data": "﴿خَابَ﴾: خَسِرَ.\n﴿دَسَّىٰهَا﴾: أخْفى نَفْسَهُ في المعاصِي."}
{"src": "almuyassar-ghareeb", "s": 91, "a_start": 11, "a_end": 11, "data": "﴿بِطَغۡوَىٰهَآ﴾: بِبُلُوغِها الغايةَ في العِصْيانِ."}
{"src": "almuyassar-ghareeb", "s": 91, "a_start": 12, "a_end": 12, "data": "﴿ٱنۢبَعَثَ﴾: نَهَضَ لِعَقْرِ النّاقةِ.\n﴿أَشۡقَىٰهَا﴾: أكْثَرُ القبيلةِ شَقاوَةً."}
{"src": "almuyassar-ghareeb", "s": 91, "a_start": 13, "a_end": 13, "data": "﴿نَاقَةَ ٱللَّهِ﴾: احْذَرُوا أن تَمَسُّوا النّاقَةَ بسُوءٍ.\n﴿وَسُقۡيَـٰهَا﴾: واحذَرُوا أن تَعْتَدُوا على سَقْيِها."}
{"src": "almuyassar-ghareeb", "s": 91, "a_start": 14, "a_end": 14, "data": "﴿فَعَقَرُوهَا﴾: فَنَحَرُوها.\n﴿فَدَمۡدَمَ عَلَيۡهِمۡ﴾: فَأَطْبَقَ عليهِم العُقُوبةَ.\n﴿فَسَوَّىٰهَا﴾: فَجَعَلَها عَلَيهِم على السَّواءِ، فلم يُفْلِتْ مِنهُم أحَدٌ."}
{"src": "almuyassar-ghareeb", "s": 91, "a_start": 15, "a_end": 15, "data": "﴿عُقۡبَـٰهَا﴾: تَبِعةَ ما أنزَلَهُ بِهِم مِنَ العِقابِ."}
