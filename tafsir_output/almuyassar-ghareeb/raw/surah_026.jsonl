{"src": "almuyassar-ghareeb", "s": 26, "a_start": 2, "a_end": 2, "data": "﴿ٱلۡكِتَـٰبِ﴾: القرآنِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 3, "a_end": 3, "data": "﴿بَـٰخِعࣱ نَّفۡسَكَ﴾: مُهْلِكُها غَمًّا وحُزْنًا."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 4, "a_end": 4, "data": "﴿ءَايَةࣰ﴾: مُعْجِزَةً.\n﴿خَـٰضِعِينَ﴾: مُنْقادِينَ بالكُرْهِ مِنهُم."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 5, "a_end": 5, "data": "﴿مُحۡدَثٍ﴾: أي: مُجَدَّدٍ إنْزالُه."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 7, "a_end": 7, "data": "﴿أَوَ لَمۡ يَرَوۡاْ﴾: أوَلَم يَنْظُرُوا.\n﴿زَوۡجࣲ كَرِيمٍ﴾: صِنْفٍ حَسَنٍ كَثِيرِ النَّفْعِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 8, "a_end": 8, "data": "﴿لَـَٔايَةࣰ﴾: لَدَلالةً واضِحَةً."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 11, "a_end": 11, "data": "﴿أَلَا يَتَّقُونَ﴾: ألا يَخافُونَ عِقابَ اللهِ تعالى؟"}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 14, "a_end": 14, "data": "﴿ذَنۢبࣱ﴾: وهو قَتْلُ القِبْطِيِّ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 15, "a_end": 15, "data": "﴿بِـَٔايَـٰتِنَآ﴾: بِمُعْجزاتِنا وحُجَجِنا.\n﴿إِنَّا مَعَكُم﴾: أي: بالعِلْمِ والحِفْظِ والنُّصْرَةِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 18, "a_end": 18, "data": "﴿أَلَمۡ نُرَبِّكَ﴾: ألم نَرْعَكَ.\n﴿وَلِيدࣰا﴾: صَغِيرًا."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 19, "a_end": 19, "data": "﴿فَعۡلَتَكَ﴾: أي: قَتْلَ القِبْطِيِّ.\n﴿مِنَ ٱلۡكَـٰفِرِينَ﴾: أي: من الجاحِدِينَ لِنِعْمَتِي."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 20, "a_end": 20, "data": "﴿مِنَ ٱلضَّآلِّينَ﴾: مِنَ المُخْطِئِينَ لا المتعَمِّدِينَ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 21, "a_end": 21, "data": "﴿حُكۡمࣰا﴾: أي: نُبُوَّةً وحِكْمَةً."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 22, "a_end": 22, "data": "﴿تَمُنُّهَا عَلَيَّ﴾: تَعُدُّها نِعْمَةً مِنكَ عليّ.\n﴿عَبَّدتَّ﴾: جَعَلْتَهُم عَبِيدًا تَذْبَحُ مَن تَشاءُ وتَتْرُكُ مَن تَشاءُ مِن أبْنائِهِم وتَسْتَبْقِي نِساءَهُم لِلْخِدْمَةِ والامْتِهانِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 30, "a_end": 30, "data": "﴿بِشَيۡءࣲ مُّبِينࣲ﴾: أي: بِبُرْهانٍ قاطِعٍ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 33, "a_end": 33, "data": "﴿بَيۡضَآءُ﴾: أي: مِن غَيرِ مَرَضٍ ولا بَرَصٍ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 34, "a_end": 34, "data": "﴿لِلۡمَلَإِ﴾: لأشْرافِ قَوْمِهِ.\n﴿لَسَـٰحِرٌ عَلِيمࣱ﴾: أي: ساحِرٌ ماهِرٌ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 36, "a_end": 36, "data": "﴿أَرۡجِهۡ﴾: أخِّرْهُ.\n﴿ٱلۡمَدَآئِنِ﴾: المُدُنِ.\n﴿حَـٰشِرِينَ﴾: جامِعِينَ للسَّحَرةِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 45, "a_end": 45, "data": "﴿تَلۡقَفُ﴾: تَبْتَلِعُ بِسُرْعَةٍ.\n﴿مَا يَأۡفِكُونَ﴾: ما يَكْذِبُونَهُ ويُمَوِّهُونَهُ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 49, "a_end": 49, "data": "﴿مِّنۡ خِلَـٰفࣲ﴾: أي: بِقَطْعِ اليَدِ اليُمْنى والرِّجْلِ اليُسْرى أو عَكْسِ ذَلِك.\n﴿وَلَأُصَلِّبَنَّكُمۡ﴾: ولَأُبالِغَنَّ في شَدِّ أطْرافِكُم ورَبْطِ أجْسادِكُم على جُذُوعِ النَّخْلِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 50, "a_end": 50, "data": "﴿لَا ضَيۡرَ﴾: لا ضَرَرَ عَلَينا فِيما يُصِيبُنا.\n﴿مُنقَلِبُونَ﴾: راجِعُونَ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 51, "a_end": 51, "data": "﴿أَوَّلَ ٱلۡمُؤۡمِنِينَ﴾: أي: مِن قَومِ فِرْعَونَ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 52, "a_end": 52, "data": "﴿أَنۡ أَسۡرِ بِعِبَادِيٓ﴾: أي: اخْرُجْ بِهِم لَيْلًا.\n﴿مُّتَّبَعُونَ﴾: يَتَّبِعُكُم فِرْعَونُ وجُنُودُه."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 53, "a_end": 53, "data": "﴿ٱلۡمَدَآئِنِ﴾: المُدُنِ.\n﴿حَـٰشِرِينَ﴾: جامِعِينَ لِلْجَيشِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 54, "a_end": 54, "data": "﴿لَشِرۡذِمَةࣱ﴾: لَطائِفَةٌ حَقِيرَةٌ قَلِيلةُ العَدَدِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 55, "a_end": 55, "data": "﴿لَنَا لَغَآئِظُونَ﴾: لَمُغْضِبُونا بِخُرُوجِهِم مِن غَيْرِ إذْنٍ مِنّا."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 56, "a_end": 56, "data": "﴿حَـٰذِرُونَ﴾: مُتَيَقِّظُونَ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 57, "a_end": 57, "data": "﴿جَنَّـٰتࣲ﴾: بَساتِينَ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 60, "a_end": 60, "data": "﴿مُّشۡرِقِينَ﴾: وقْتَ شُرُوقِ الشَّمْسِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 61, "a_end": 61, "data": "﴿ٱلۡجَمۡعَانِ﴾: جَمْعُ مُوسى وهُم بنُو إسْرائيلَ، وجَمْعُ فِرْعَونَ وهم القِبْطُ.\n﴿لَمُدۡرَكُونَ﴾: لَمُلحَقُون من قِبَلِ فِرْعَونَ وجُنُودِهِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 63, "a_end": 63, "data": "﴿فَٱنفَلَقَ﴾: أي: انْشَقَّ البَحْرُ إلى اثْنَي عَشْرَ طَرِيقًا.\n﴿فِرۡقࣲ﴾: قِطْعةٍ من البحْرِ مُرْتَفِعَةٍ.\n﴿كَٱلطَّوۡدِ﴾: كالجَبَلِ المُتَطاوِلِ في السَّماءِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 64, "a_end": 64, "data": "﴿وَأَزۡلَفۡنَا﴾: وقَرَّبْنا.\n﴿ثَمَّ﴾: هُناك.\n﴿ٱلۡـَٔاخَرِينَ﴾: وهم فِرْعَونُ وقَوْمُه."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 67, "a_end": 67, "data": "﴿لَـَٔايَةࣰ﴾: لَعِبرةً عَجِيبةً."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 71, "a_end": 71, "data": "﴿لَهَا عَـٰكِفِينَ﴾: على عِبادتِها مُقِيمِينَ على الدَّوامِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 75, "a_end": 75, "data": "﴿أَفَرَءَيۡتُم﴾: هَل تأمَّلْتُم ما أنْتُم عَلَيه؟"}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 82, "a_end": 82, "data": "﴿يَوۡمَ ٱلدِّينِ﴾: يومَ الجَزاءِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 83, "a_end": 83, "data": "﴿حُكۡمࣰا﴾: عِلْمًا وفَهْمًا."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 84, "a_end": 84, "data": "﴿لِسَانَ صِدۡقࣲ﴾: ثَناءً حَسَنًا.\n﴿فِي ٱلۡـَٔاخِرِينَ﴾: أي: في الَّذينَ يأتُونَ بَعْدِي إلى يومِ القِيامَةِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 87, "a_end": 87, "data": "﴿وَلَا تُخۡزِنِي﴾: ولا تَفْضَحْنِي."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 89, "a_end": 89, "data": "﴿بِقَلۡبࣲ سَلِيمࣲ﴾: أي: مِنَ النِّفاقِ والكُفْرِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 90, "a_end": 90, "data": "﴿وَأُزۡلِفَتِ﴾: قُرِّبَتْ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 91, "a_end": 91, "data": "﴿وَبُرِّزَتِ﴾: أُظْهِرَتْ.\n﴿لِلۡغَاوِينَ﴾: للضّالِينَ عَن طَرِيقِ الهِدايةِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 94, "a_end": 94, "data": "﴿فَكُبۡكِبُواْ فِيهَا﴾: أُلْقُوا في جَهَنَّمَ على وُجُوهِهِم مرَّةً بَعْدَ مَرَّةٍ إلى أنِ اسْتَقرُّوا في قَعْرِها."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 96, "a_end": 96, "data": "﴿يَخۡتَصِمُونَ﴾: يَتَنازَعُون."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 97, "a_end": 97, "data": "﴿إِن كُنَّا﴾: إنَّنا كُنّا."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 98, "a_end": 98, "data": "﴿نُسَوِّيكُم بِرَبِّ ٱلۡعَـٰلَمِينَ﴾: نَجْعَلُكُم مِثْلَ رَبِّ العالَمِينَ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 100, "a_end": 100, "data": "﴿شَـٰفِعِينَ﴾: فَيُخَلِّصُونا مِنَ العَذابِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 101, "a_end": 101, "data": "﴿حَمِيمࣲ﴾: قَرِيبٍ ومُشْفِقٍ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 102, "a_end": 102, "data": "﴿كَرَّةࣰ﴾: رَجْعَةً إلى الدُّنيا."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 111, "a_end": 111, "data": "﴿ٱلۡأَرۡذَلُونَ﴾: أي: أسافلُ النّاسِ وأَراذِلُهم."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 116, "a_end": 116, "data": "﴿ٱلۡمَرۡجُومِينَ﴾: مِنَ المقْتُولِينَ رَمْيًا بالحِجارَةِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 118, "a_end": 118, "data": "﴿فَٱفۡتَحۡ﴾: فاحْكُمْ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 119, "a_end": 119, "data": "﴿ٱلۡمَشۡحُونِ﴾: المَمْلُوءِ بالنّاسِ والدَّوابِّ والمتاعِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 128, "a_end": 128, "data": "﴿رِيعٍ﴾: مكانٍ مُرْتَفِعٍ.\n﴿ءَايَةࣰ﴾: بِناءً شامِخًا."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 129, "a_end": 129, "data": "﴿مَصَانِعَ﴾: حُصُونًا أو قُصُورًا.\n﴿تَخۡلُدُونَ﴾: أي: تَبْقَونَ في الدُّنيا ولا تَمُوتُونَ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 130, "a_end": 130, "data": "﴿بَطَشۡتُم﴾: أخَذْتُم بِعُنْفٍ.\n﴿جَبَّارِينَ﴾: قاهِرِينَ ظالِمِين."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 132, "a_end": 132, "data": "﴿أَمَدَّكُم﴾: أنْعَمَ عليكُم وأَعْطاكُم."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 133, "a_end": 133, "data": "﴿بِأَنۡعَـٰمࣲ﴾: مِنَ الإبِلِ والبَقَرِ والغَنَمِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 134, "a_end": 134, "data": "﴿وَجَنَّـٰتࣲ﴾: حَدائِقَ وبَساتِينَ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 137, "a_end": 137, "data": "﴿إِنۡ هَـٰذَآ﴾: ما هَذا.\n﴿خُلُقُ ٱلۡأَوَّلِينَ﴾: دِينُ الأوَّلِينَ وعاداتُهُم."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 146, "a_end": 146, "data": "﴿مَا هَـٰهُنَآ﴾: أي: في الدُّنيا."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 148, "a_end": 148, "data": "﴿طَلۡعُهَا﴾: ثَمَرُها.\n﴿هَضِيمࣱ﴾: مُنْكَسِرٌ مِن لِينِهِ ورُطُوبَتِه."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 149, "a_end": 149, "data": "﴿فَـٰرِهِينَ﴾: ماهِرِين بنَحْتِها."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 153, "a_end": 153, "data": "﴿مِنَ ٱلۡمُسَحَّرِينَ﴾: مِنَ المغْلُوبِ على عُقُولِهِم بِكَثْرَةِ السِّحرِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 154, "a_end": 154, "data": "﴿بِـَٔايَةٍ﴾: بِحُجَّةٍ واضِحَةٍ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 155, "a_end": 155, "data": "﴿لَّهَا شِرۡبࣱ﴾: لها نَصِيبٌ مِنَ الماءِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 157, "a_end": 157, "data": "﴿فَعَقَرُوهَا﴾: فَنَحَرُوها."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 165, "a_end": 165, "data": "﴿أَتَأۡتُونَ ٱلذُّكۡرَانَ﴾: أتَنْكِحُونَ الرِّجالَ؟"}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 166, "a_end": 166, "data": "﴿وَتَذَرُونَ﴾: وتَتْرُكُونَ.\n﴿عَادُونَ﴾: مُتَجاوِزُونَ ما أباحَهُ اللهُ لَكُم مِنَ الحَلالِ إلى الحَرامِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 168, "a_end": 168, "data": "﴿مِّنَ ٱلۡقَالِينَ﴾: مِنَ المُبْغِضِينَ أشَدَّ البُغْضِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 171, "a_end": 171, "data": "﴿فِي ٱلۡغَـٰبِرِينَ﴾: في الباقِينَ في العذابِ والهلاكِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 172, "a_end": 172, "data": "﴿دَمَّرۡنَا﴾: أهْلَكْنا."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 176, "a_end": 176, "data": "﴿أَصۡحَـٰبُ لۡـَٔيۡكَةِ﴾: أصْحابُ الشَّجَرِ المُلْتَفِّ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 181, "a_end": 181, "data": "﴿مِنَ ٱلۡمُخۡسِرِينَ﴾: مِنَ النّاقِصِينَ للحُقُوقِ بالتَّطفِيفِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 182, "a_end": 182, "data": "﴿بِٱلۡقِسۡطَاسِ﴾: بالميزانِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 183, "a_end": 183, "data": "﴿وَلَا تَبۡخَسُواْ﴾: ولا تَنْقُصُوا.\n﴿وَلَا تَعۡثَوۡاْ﴾: ولا تُفْسِدُوا أشَدَّ الإفْسادِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 184, "a_end": 184, "data": "﴿وَٱلۡجِبِلَّةَ ٱلۡأَوَّلِينَ﴾: والخَلائِقَ من الأُمَمِ المتقدِّمةِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 185, "a_end": 185, "data": "﴿مِنَ ٱلۡمُسَحَّرِينَ﴾: مِنَ المغلُوبِ على عُقُولِهِم بِكَثْرَةِ السِّحْرِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 187, "a_end": 187, "data": "﴿كِسَفࣰا﴾: قِطَعَ عَذابٍ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 189, "a_end": 189, "data": "﴿يَوۡمِ ٱلظُّلَّةِ﴾: أي: أظَلَّتْهُم سَحابَةٌ، ثُمَّ أمْطَرَتْهُم نارًَا."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 193, "a_end": 193, "data": "﴿ٱلرُّوحُ ٱلۡأَمِينُ﴾: جِبْرِيلُ عَلَيهِ السَّلامُ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 196, "a_end": 196, "data": "﴿وَإِنَّهُۥ﴾: وإنَّ ذِكْرَ هَذا القُرآنِ.\n﴿زُبُرِ ٱلۡأَوَّلِينَ﴾: كُتُبِ الرُّسُلِ السّابِقِينَ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 198, "a_end": 198, "data": "﴿ٱلۡأَعۡجَمِينَ﴾: الَّذِينَ لا يتكَلَّمُونَ باللغةِ العَربيةِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 200, "a_end": 200, "data": "﴿سَلَكۡنَـٰهُ﴾: أدْخَلْناه."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 202, "a_end": 202, "data": "﴿بَغۡتَةࣰ﴾: فَجْأَةً."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 203, "a_end": 203, "data": "﴿مُنظَرُونَ﴾: مُمْهَلُون لِنُؤمِنَ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 205, "a_end": 205, "data": "﴿مَّتَّعۡنَـٰهُمۡ سِنِينَ﴾: أي: طَوَّلْنا لَهُم أعْمارَهُم."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 207, "a_end": 207, "data": "﴿مَآ أَغۡنَىٰ عَنۡهُم﴾: أي: لم يَنْفَعْهُم."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 209, "a_end": 209, "data": "﴿ذِكۡرَىٰ﴾: أي: تَذْكِيرٌ وتَنْبِيهٌ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 211, "a_end": 211, "data": "﴿وَمَا يَنۢبَغِي لَهُمۡ﴾: ولا يَصِحُّ مِنهُم."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 212, "a_end": 212, "data": "﴿لَمَعۡزُولُونَ﴾: لمحْجُوُبونَ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 214, "a_end": 214, "data": "﴿عَشِيرَتَكَ﴾: قَبِيلَتَكَ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 215, "a_end": 215, "data": "﴿وَٱخۡفِضۡ جَنَاحَكَ﴾: ألِنْ جانِبَكَ وتَواضَعْ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 219, "a_end": 219, "data": "﴿وَتَقَلُّبَكَ﴾: وتَصرُّفَكَ أو تَقَلُّبَكَ في الرُّكُوعِ والسُّجُودِ والقِيامِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 222, "a_end": 222, "data": "﴿أَفَّاكٍ﴾: كَذّابٍ.\n﴿أَثِيمࣲ﴾: كَثِيرِ الآثامِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 223, "a_end": 223, "data": "﴿يُلۡقُونَ ٱلسَّمۡعَ﴾: يُلْقُونَ ما سَمِعُوه مِنَ السَّماءِ إلى الكُهّانِ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 224, "a_end": 224, "data": "﴿ٱلۡغَاوُۥنَ﴾: الضّالُّونَ عَنِ الحقِّ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 225, "a_end": 225, "data": "﴿كُلِّ وَادࣲ﴾: كلِّ فَنٍّ مِن فُنُونِ الكَذِبِ.\n﴿يَهِيمُونَ﴾: يخُوضُونَ."}
{"src": "almuyassar-ghareeb", "s": 26, "a_start": 227, "a_end": 227, "data": "﴿يَنقَلِبُونَ﴾: يَرْجِعُونَ إليهِ."}
