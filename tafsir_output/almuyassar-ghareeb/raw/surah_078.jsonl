{"src": "almuyassar-ghareeb", "s": 78, "a_start": 1, "a_end": 1, "data": "﴿عَمَّ﴾: عَنْ أيِّ شَيءٍ.\n﴿يَتَسَآءَلُونَ﴾: يَسْأَلُ بعضُ كُفّارِ قُريشٍ بَعْضًا."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 2, "a_end": 2, "data": "﴿ٱلنَّبَإِ ٱلۡعَظِيمِ﴾: الخبرِ العَظِيمِ الشَّأنِ، وهو القُرآنُ العَظِيمُ الَّذي يُنْبِئُ عَنِ البَعْثِ."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 4, "a_end": 4, "data": "﴿كَلَّا﴾: ليسَ الأمْرُ كَما يَزْعُمُ هَؤلاءِ المشْرِكُونَ.\n﴿سَيَعۡلَمُونَ﴾: أي: عاقبةَ تَكْذِيبِهِم."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 6, "a_end": 6, "data": "﴿مِهَـٰدࣰا﴾: مُمَهَّدَةً لَكُم كالفِراشِ."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 7, "a_end": 7, "data": "﴿أَوۡتَادࣰا﴾: رَواسِيَ."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 8, "a_end": 8, "data": "﴿أَزۡوَ ٰ⁠جࣰا﴾: أصْنافًا ذَكَرًا وأُنْثى."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 9, "a_end": 9, "data": "﴿سُبَاتࣰا﴾: راحةً لأبدانِكُم، وتَسْكُنونَ؟"}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 10, "a_end": 10, "data": "﴿لِبَاسࣰا﴾: تَلْبَسُكُم ظُلْمَتُهُ، كَما يَسْتُرُ الثَّوبُ لابِسَهُ."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 11, "a_end": 11, "data": "﴿مَعَاشࣰا﴾: تَنتَشِرُونَ فِيهَ لِمصالِحِكُم."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 12, "a_end": 12, "data": "﴿سَبۡعࣰا﴾: سَبْعَ سَمَواتٍ.\n﴿شِدَادࣰا﴾: مَتِينَةَ البِناءِ، مُحْكَمةَ الخَلْقِ والإنْشاءِ."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 13, "a_end": 13, "data": "﴿سِرَاجࣰا﴾: شَمْسًا.\n﴿وَهَّاجࣰا﴾: وقّادًا مُضِيئًا."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 14, "a_end": 14, "data": "﴿ٱلۡمُعۡصِرَ ٰ⁠تِ﴾: السُّحُبِ المُمْطِرَةِ.\n﴿ثَجَّاجࣰا﴾: منصَبًّا بِكَثْرِةٍ."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 16, "a_end": 16, "data": "﴿أَلۡفَافًا﴾: مُلْتَفَّةً بعْضُها بِبَعْضٍ."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 17, "a_end": 17, "data": "﴿يَوۡمَ ٱلۡفَصۡلِ﴾: بينَ الخلْقِ، وهوَ يومُ القِيامَةِ.\n﴿مِيقَـٰتࣰا﴾: وقْتًا ومِيعادًا مُحَدَّدًا للأولِينَ والآخِرِينَ."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 18, "a_end": 18, "data": "﴿يُنفَخُ فِي ٱلصُّورِ﴾: يَنفُخُ المَلَكُ في «القَرْنِ» إيذانًا بالبَعْثِ.\n﴿أَفۡوَاجࣰا﴾: أُمَمًا، كلُّ أُمَّةٍ مع إمامِهِم."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 19, "a_end": 19, "data": "﴿وَفُتِحَتِ﴾: شُقِّقَتْ وصُدِّعتْ.\n﴿أَبۡوَ ٰ⁠بࣰا﴾: ذاتَ أبوابٍ كَثِيرةٍ."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 20, "a_end": 20, "data": "﴿وَسُيِّرَتِ ٱلۡجِبَالُ﴾: ونُسِفَتِ الجِبالُ.\n﴿سَرَابًا﴾: يَظُنُّ مَن يَراهُ مِن بُعْدٍ ماءً، وهو في الحقِيقَةِ هَباءٌ."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 21, "a_end": 21, "data": "﴿مِرۡصَادࣰا﴾: تَرْقُبُ مَن يجتازُها."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 22, "a_end": 22, "data": "﴿لِّلطَّـٰغِينَ﴾: للكافِرِينَ الَّذِينَ طَغَوا.\n﴿مَـَٔابࣰا﴾: مَرْجِعًا."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 23, "a_end": 23, "data": "﴿لَّـٰبِثِينَ﴾: ماكِثِينَ.\n﴿أَحۡقَابࣰا﴾: دُهُورًا مُتَعاقِبةً لا تَنْقَطِعُ."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 24, "a_end": 24, "data": "﴿لَّا يَذُوقُونَ﴾: لا يُحِسُّونَ.\n﴿بَرۡدࣰا﴾: نَسِيمًا باردًا.\n﴿شَرَابًا﴾: ماءً يُرْوي."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 25, "a_end": 25, "data": "﴿حَمِيمࣰا﴾: ماءً حارًّا.\n﴿وَغَسَّاقࣰا﴾: وصَدِيدَ أهْلِ النّارِ."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 26, "a_end": 26, "data": "﴿وِفَاقًا﴾: مُوافِقًا لأَعْمالِهِم."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 27, "a_end": 27, "data": "﴿لَا يَرۡجُونَ حِسَابࣰا﴾: لا يَتَوَقَّعُونَ وُقُوعَ الجَزاءِ يَومَ القِيامَةِ."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 28, "a_end": 28, "data": "﴿بِـَٔايَـٰتِنَا﴾: بِما جاءَتْهُم بِهِ الرُّسُلُ."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 29, "a_end": 29, "data": "﴿كِتَـٰبࣰا﴾: كَتَبْناهُ في اللَّوحِ المَحْفُوظِ."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 31, "a_end": 31, "data": "﴿مَفَازًا﴾: فَوْزًا بِدُخُولِهِم الجنَّةَ."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 33, "a_end": 33, "data": "﴿وَكَوَاعِبَ﴾: نَواهِدَ، أثْداؤُهنَّ مُرْتَفِعَةٌ لم تَتَدَلَّ.\n﴿أَتۡرَابࣰا﴾: مُسْتَوِياتٍ في سِنٍّ واحِدةٍ."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 34, "a_end": 34, "data": "﴿دِهَاقࣰا﴾: مَمْلُوءةً خَمْرًا."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 35, "a_end": 35, "data": "﴿لَّا يَسۡمَعُونَ فِيهَا لَغۡوࣰا﴾: باطِلًا مِنَ القول.\n﴿وَلَا كِذَّ ٰ⁠بࣰا﴾: ولا تَكْذِيبًا."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 36, "a_end": 36, "data": "﴿حِسَابࣰا﴾: كَثِيرًا كافيًا لَهُم."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 37, "a_end": 37, "data": "﴿لَا يَمۡلِكُونَ مِنۡهُ خِطَابࣰا﴾: لا يَسْتَطِيعُونَ خِطابًا يُبَلِّغُونَهُ إلى اللهِ."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 38, "a_end": 38, "data": "﴿ٱلرُّوحُ﴾: جِبْريِلُ.\n﴿صَفࣰّا﴾: مُصْطَفِّينَ.\n﴿صَوَابࣰا﴾: حَقًّا وسَدادًا."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 39, "a_end": 39, "data": "﴿ٱلۡيَوۡمُ ٱلۡحَقُّ﴾: الثابِتُ الَّذِي لا رَيْبَ في وُقُوعِهِ.\n﴿مَـَٔابًا﴾: مَرْجِعًا."}
{"src": "almuyassar-ghareeb", "s": 78, "a_start": 40, "a_end": 40, "data": "﴿أَنذَرۡنَـٰكُمۡ﴾: حَذَّرْناكُم.\n﴿مَا قَدَّمَتۡ يَدَاهُ﴾: ما عَمِلَ من خِيرٍ أو شَرٍّ.\n﴿يَـٰلَيۡتَنِي كُنتُ تُرَ ٰ⁠بَۢا﴾: فلم أُبْعَثْ."}
