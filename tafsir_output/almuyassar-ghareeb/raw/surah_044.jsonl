{"src": "almuyassar-ghareeb", "s": 44, "a_start": 1, "a_end": 1, "data": "﴿حمٓ﴾: سَبَقَ الكلامُ عَلى الحُرُوفِ المقَطَّعةِ أوَّلَ سُورَةِ البقرةِ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 2, "a_end": 2, "data": "﴿ٱلۡمُبِينِ﴾: الواضِحِ لَفْظًا ومَعْنىً."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 3, "a_end": 3, "data": "﴿مُّبَـٰرَكَةٍ﴾: كَثِيرَةِ الخَيراتِ، وهي لَيلةُ القَدْرِ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 4, "a_end": 4, "data": "﴿يُفۡرَقُ﴾: يُقضى ويُفَصَّلُ مِنَ اللوحِ المحْفُوظِ إلى الكَتَبةِ مِنَ الملائِكَةِ.\n﴿حَكِيمٍ﴾: مُحْكَمٍ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 10, "a_end": 10, "data": "﴿فَٱرۡتَقِبۡ﴾: فانْتَظِرْ.\n﴿بِدُخَانࣲ﴾: ظُلْمَةٍ كَهَيئَةِ الدُّخانِ بِسَبِبِ الجَدْبِ.\n﴿مُّبِينࣲ﴾: واضِحٍ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 11, "a_end": 11, "data": "﴿يَغۡشَى﴾: يَعُمُّ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 13, "a_end": 13, "data": "﴿أَنَّىٰ﴾: كَيفَ.\n﴿ٱلذِّكۡرَىٰ﴾: التَّذَكُّرُ والاتِّعاظُ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 14, "a_end": 14, "data": "﴿تَوَلَّوۡاْ عَنۡهُ﴾: أعْرَضُوا عَنْه.\n﴿مُعَلَّمࣱ﴾: عَلَّمَه بَشَرٌ أو الكَهَنَةُ أو الشَّياطِينُ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 16, "a_end": 16, "data": "﴿نَبۡطِشُ﴾: نُعَذِّبُ، والبَطْشُ أخْذٌ بِشِدَّةٍ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 17, "a_end": 17, "data": "﴿فَتَنَّا﴾: ابْتَلينا واخْتَبَرْنا."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 18, "a_end": 18, "data": "﴿أَدُّوٓاْ﴾: سَلِّمُوا وأرْسِلُوا مَعِي.\n﴿عِبَادَ ٱللَّهِ﴾: بَنِي إسْرائِيلَ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 19, "a_end": 19, "data": "﴿وَأَن لَّا تَعۡلُواْ عَلَى ٱللَّهِ﴾: لا تَتَكَبَّرُوا على اللهِ بِتَكْذِيبِ رُسُلِه.\n﴿بِسُلۡطَـٰنࣲ﴾: بِبُرْهانٍ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 20, "a_end": 20, "data": "﴿عُذۡتُ بِرَبِّي﴾: استَجَرْتُ بِاللهِ.\n﴿تَرۡجُمُونِ﴾: تَقْتُلُوني رَجْمًا بالحِجارَةِ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 21, "a_end": 21, "data": "﴿فَٱعۡتَزِلُونِ﴾: كُفُّوا عَنْ أذايَ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 22, "a_end": 22, "data": "﴿مُّجۡرِمُونَ﴾: مُشْرِكُونَ بِاللهِ كافِرُونَ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 23, "a_end": 23, "data": "﴿فَأَسۡرِ﴾: اجْعَلْهُم يَسِيُرونَ لَيلًا."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 24, "a_end": 24, "data": "﴿رَهۡوًا﴾: ساكِنًا مُسْتَقِرًّا عَلى حالِه مُنْفَرِجًا."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 26, "a_end": 26, "data": "﴿وَمَقَامࣲ كَرِيمࣲ﴾: ومَنازِلَ جَمِيلَةٍ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 27, "a_end": 27, "data": "﴿وَنَعۡمَةࣲ﴾: عَيْشٍ لَيِّنٍ رَغْدٍ.\n﴿فَـٰكِهِينَ﴾: مُتَنَعِّمِينَ، مُتْرَفِينَ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 28, "a_end": 28, "data": "﴿كَذَ ٰ⁠لِكَ﴾: مِثْلَ ذَلِكَ العِقابِ يُعاقِبُ اللهُ مَن كَذَّبَ، وبَدّلَ نِعْمةَ اللهِ كُفْرًا.\n﴿وَأَوۡرَثۡنَـٰهَا﴾: ومَلَّكْناها."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 29, "a_end": 29, "data": "﴿مُنظَرِينَ﴾: مُؤَخَّرِينَ عَنِ العُقُوبَةِ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 30, "a_end": 30, "data": "﴿ٱلۡمُهِينِ﴾: المُذِلِّ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 31, "a_end": 31, "data": "﴿عَالِيࣰا﴾: جَبّارًا.\n﴿مِّنَ ٱلۡمُسۡرِفِينَ﴾: مُتَجاوِزًا للحَدِّ في العُلوِّ والتَّكَبُّرِ عَلى عبادِ اللهِ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 32, "a_end": 32, "data": "﴿ٱلۡعَـٰلَمِينَ﴾: عالَمِي زَمانِهِم."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 33, "a_end": 33, "data": "﴿ٱلۡـَٔايَـٰتِ﴾: الُمعْجِزاتِ.\n﴿بَلَـٰٓؤࣱاْ﴾: اخْتِبارٌ بالرَّخاءِ والشِّدَةِ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 35, "a_end": 35, "data": "﴿بِمُنشَرِينَ﴾: بِمَبْعُوثِينَ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 37, "a_end": 37, "data": "﴿تُبَّعࣲ﴾: أحَدِ مُلُوكِ اليمنِ الحِمْيَرِيِّينَ مِمَّن جَمَعَ مُلْكَ مَناطِقِ اليمنِ كُلِّها."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 40, "a_end": 40, "data": "﴿يَوۡمَ ٱلۡفَصۡلِ﴾: يومَ القَضاءِ بَينَ الخَلْقِ.\n﴿مِيقَـٰتُهُمۡ﴾: مَوعِدُ جزائِهِم"}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 41, "a_end": 41, "data": "﴿يُغۡنِي﴾: يَدْفَعُ.\n﴿مَّوۡلࣰى﴾: صاحِبٌ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 43, "a_end": 43, "data": "﴿شَجَرَتَ ٱلزَّقُّومِ﴾: شَجَرةً كَرِيهةَ الرّائِحَةِ صَغِيرةَ الوَرَقِ مَسْمُومةً خَلَقَها اللهُ في جَهَنَّمَ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 44, "a_end": 44, "data": "﴿ٱلۡأَثِيمِ﴾: الكَثِيرِ الآثامِ، والمرادُ بِه المشْرِكُ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 45, "a_end": 45, "data": "﴿كَٱلۡمُهۡلِ﴾: كالمَعْدَنِ المُذابِ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 46, "a_end": 46, "data": "﴿ٱلۡحَمِيمِ﴾: الماءِ الَّذِي بَلَغَ الغايَةَ فِي الحرارةِ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 47, "a_end": 47, "data": "﴿فَٱعۡتِلُوهُ﴾: ادْفَعُوهُ وقُودُوهُ بِعُنْفٍ.\n﴿سَوَآءِ﴾: وسَطِ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 48, "a_end": 48, "data": "﴿صُبُّواْ﴾: أفْرِغُوا."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 49, "a_end": 49, "data": "﴿ذُقۡ﴾: قُولُوا لَهُ عَلى وجْهِ الإهانَةِ: أحْسِسْ.\n﴿أَنتَ ٱلۡعَزِيزُ ٱلۡكَرِيمُ﴾: أي: الذَّلِيلُ المُهانُ، عُكِسَ المَدْلُولُ للتَّهَكُّمِ بِهِ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 50, "a_end": 50, "data": "﴿تَمۡتَرُونَ﴾: تَشُكُّونَ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 51, "a_end": 51, "data": "﴿مَقَامٍ﴾: مَسْكَنٍ.\n﴿أَمِينࣲ﴾: آمِنٍ صاحِبُه مِنَ الآفاتِ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 53, "a_end": 53, "data": "﴿سُندُسࣲ﴾: الرقِيقِ مِنَ الحرِيرِ الخالِصِ.\n﴿وَإِسۡتَبۡرَقࣲ﴾: الغليظِ مِنَ الحريرِ الخالصِ.\n﴿مُّتَقَـٰبِلِينَ﴾: أي: في مَجالِسِهِم ومُحادَثاتِهِم."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 54, "a_end": 54, "data": "﴿وَزَوَّجۡنَـٰهُم﴾: قَرنّاهُم.\n﴿بِحُورٍ﴾: جَمْعُ حَوْراءَ وهي البيضاءُ.\n﴿عِينࣲ﴾: واسِعاتِ الأَعْيُنِ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 55, "a_end": 55, "data": "﴿يَدۡعُونَ﴾: يَطْلُبُونَ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 56, "a_end": 56, "data": "﴿ٱلۡمَوۡتَةَ ٱلۡأُولَىٰ﴾: الَّتِي سَلَفَتْ لَهُم في الُّدنيا."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 58, "a_end": 58, "data": "﴿يَسَّرۡنَـٰهُ﴾: سَهَّلْنا لَفْظَ القرآنِ ومَعْناهُ."}
{"src": "almuyassar-ghareeb", "s": 44, "a_start": 59, "a_end": 59, "data": "﴿فَٱرۡتَقِبۡ﴾: فانْتَظِر ما وعَدْتُكَ.\n﴿مُّرۡتَقِبُونَ﴾: مُنْتَظِرُونَ موتَكَ وقَهْرَكَ."}
