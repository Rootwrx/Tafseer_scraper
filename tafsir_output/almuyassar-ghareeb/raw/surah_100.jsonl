{"src": "almuyassar-ghareeb", "s": 100, "a_start": 1, "a_end": 1, "data": "﴿وَٱلۡعَـٰدِيَـٰتِ﴾: أقْسَمَ اللهُ تَعالى بالخَيلِ الجارياتِ في سَبِيلِ اللهِ.\n﴿ضَبۡحࣰا﴾: حِينَ يَظْهَرُ صَوْتُها مِن سُرْعَةِ عَدْوِها."}
{"src": "almuyassar-ghareeb", "s": 100, "a_start": 2, "a_end": 2, "data": "﴿فَٱلۡمُورِيَـٰتِ قَدۡحࣰا﴾: فالخَيلِ اللاتِي تَنْقَدِحُ النّارُ مِن حَوافِرِها؛ من شِدَّةِ عَدْوِها."}
{"src": "almuyassar-ghareeb", "s": 100, "a_start": 3, "a_end": 3, "data": "﴿فَٱلۡمُغِيرَ ٰ⁠تِ﴾: فالمُغِيراتِ عَلى الأعداءِ.\n﴿صُبۡحࣰا﴾: عِنْدَ الصُّبْحِ."}
{"src": "almuyassar-ghareeb", "s": 100, "a_start": 4, "a_end": 4, "data": "﴿فَأَثَرۡنَ بِهِۦ﴾: فهَيَّجْنَ بِهذا العَدْوِ.\n﴿نَقۡعࣰا﴾: غُبارًا."}
{"src": "almuyassar-ghareeb", "s": 100, "a_start": 5, "a_end": 5, "data": "﴿فَوَسَطۡنَ بِهِۦ﴾: فتوسَّطْنَ بِرُكْبانِهِنَّ.\n﴿جَمۡعًا﴾: جُموعَ الأعداءِ."}
{"src": "almuyassar-ghareeb", "s": 100, "a_start": 6, "a_end": 6, "data": "﴿لِرَبِّهِۦ لَكَنُودࣱ﴾: لِنِعَمِ رَبَّهِ لَجَحُودٌ."}
{"src": "almuyassar-ghareeb", "s": 100, "a_start": 7, "a_end": 7, "data": "﴿عَلَىٰ ذَ ٰ⁠لِكَ لَشَهِيدࣱ﴾: مُقِرٌّ بِجُحُودِهِ."}
{"src": "almuyassar-ghareeb", "s": 100, "a_start": 8, "a_end": 8, "data": "﴿ٱلۡخَيۡرِ﴾: المالِ."}
{"src": "almuyassar-ghareeb", "s": 100, "a_start": 9, "a_end": 9, "data": "﴿بُعۡثِرَ مَا فِي ٱلۡقُبُورِ﴾: أخْرَجَ اللهُ الأمواتَ مِنَ القُبُورِ لِلْحِسابِ؟"}
{"src": "almuyassar-ghareeb", "s": 100, "a_start": 10, "a_end": 10, "data": "﴿وَحُصِّلَ﴾: واسْتُخْرِجَ.\n﴿مَا فِي ٱلصُّدُورِ﴾: ما اسْتَتَرَ في الصُّدُورِ مِن خَيْرٍ أو شَرٍّ."}
{"src": "almuyassar-ghareeb", "s": 100, "a_start": 11, "a_end": 11, "data": "﴿لَّخَبِيرُۢ﴾: لَمُطَّلِعٌ على باطِنِ أمْرِهِم فلا يَخْفى عَلَيهِ شيءٌ مِن ذَلِكَ."}
