{"src": "almuyassar-ghareeb", "s": 84, "a_start": 1, "a_end": 1, "data": "﴿ٱنشَقَّتۡ﴾: تَصَدَّعتْ يومَ القِيامَةِ."}
{"src": "almuyassar-ghareeb", "s": 84, "a_start": 2, "a_end": 2, "data": "﴿وَأَذِنَتۡ لِرَبِّهَا﴾: وأَطاعَتْ أمْرَ رَبِّها.\n﴿وَحُقَّتۡ﴾: وحُقَّ لَها أن تَنقادَ لِأَمْرِهِ."}
{"src": "almuyassar-ghareeb", "s": 84, "a_start": 3, "a_end": 3, "data": "﴿مُدَّتۡ﴾: بُسِطَتْ ووُسِّعَتْ."}
{"src": "almuyassar-ghareeb", "s": 84, "a_start": 4, "a_end": 4, "data": "﴿وَأَلۡقَتۡ مَا فِيهَا﴾: وقَذَفَتْ ما في بَطْنِها مِنَ الأمْواتِ.\n﴿وَتَخَلَّتۡ﴾: لم يَبْقَ شَيءٌ مِمّا في بَطْنِها."}
{"src": "almuyassar-ghareeb", "s": 84, "a_start": 5, "a_end": 5, "data": "﴿وَأَذِنَتۡ لِرَبِّهَا﴾: وانْقادَتْ لِرَبِها فِيما أمَرها بِهِ."}
{"src": "almuyassar-ghareeb", "s": 84, "a_start": 6, "a_end": 6, "data": "﴿كَادِحٌ﴾: ساعٍ إلى اللهِ.\n﴿فَمُلَـٰقِيهِ﴾: تُلاقِي الله يَومَ القِيامَةِ."}
{"src": "almuyassar-ghareeb", "s": 84, "a_start": 7, "a_end": 7, "data": "﴿أُوتِيَ كِتَـٰبَهُۥ﴾: أُعطِيَ صَحِيفةَ أعمالِهِ."}
{"src": "almuyassar-ghareeb", "s": 84, "a_start": 8, "a_end": 8, "data": "﴿يَسِيرࣰا﴾: سَهْلا."}
{"src": "almuyassar-ghareeb", "s": 84, "a_start": 9, "a_end": 9, "data": "﴿وَيَنقَلِبُ﴾: ويَرْجِعُ."}
{"src": "almuyassar-ghareeb", "s": 84, "a_start": 10, "a_end": 10, "data": "﴿كِتَـٰبَهُۥ﴾: صَحِيفةَ أعْمالِهِ."}
{"src": "almuyassar-ghareeb", "s": 84, "a_start": 11, "a_end": 11, "data": "﴿ثُبُورࣰا﴾: بِالهَلاكِ."}
{"src": "almuyassar-ghareeb", "s": 84, "a_start": 12, "a_end": 12, "data": "﴿وَيَصۡلَىٰ سَعِيرًا﴾: ويَدْخُلُ النّارَ مُقاسِيًا حَرَّها."}
{"src": "almuyassar-ghareeb", "s": 84, "a_start": 13, "a_end": 13, "data": "﴿مَسۡرُورًا﴾: مَغْرُورًا لا يُفَكِّرُ في العواقِبِ."}
{"src": "almuyassar-ghareeb", "s": 84, "a_start": 14, "a_end": 14, "data": "﴿يَحُورَ﴾: يَرْجِعَ إلى خالِقِه لِلْحِسابِ."}
{"src": "almuyassar-ghareeb", "s": 84, "a_start": 16, "a_end": 16, "data": "﴿بِٱلشَّفَقِ﴾: باحْمِرارِ الأُفُقِ عِنْدَ الغُرُوب."}
{"src": "almuyassar-ghareeb", "s": 84, "a_start": 17, "a_end": 17, "data": "﴿وَمَا وَسَقَ﴾: وما جَمَعَ من الدَّوابِّ والحَشراتِ والهَوامِّ وغَيرِ ذَلِكَ."}
{"src": "almuyassar-ghareeb", "s": 84, "a_start": 18, "a_end": 18, "data": "﴿ٱتَّسَقَ﴾: تَكامَلَ نُورُهُ."}
{"src": "almuyassar-ghareeb", "s": 84, "a_start": 19, "a_end": 19, "data": "﴿طَبَقًا عَن طَبَقࣲ﴾: أطوارًا مُتَعَدِّدَةً وأَحْوالًا مُتَبايِنَةً: مِنَ النُّطْفَةِ إلى العَلَقَةِ إلى المُضْغةِ إلى نَفْخِ الرُّوحِ، إلى الموتِ، إلى البعْثِ والنُّشُورِ."}
{"src": "almuyassar-ghareeb", "s": 84, "a_start": 20, "a_end": 20, "data": "﴿فَمَا لَهُمۡ لَا يُؤۡمِنُونَ﴾: فأيُّ شَيءٍ يَمْنَعُهُم مِنَ الإيمانِ بَعْدَ ما وُضِّحَتْ لَهُمُ الآياتُ؟"}
{"src": "almuyassar-ghareeb", "s": 84, "a_start": 21, "a_end": 21, "data": "﴿لَا يَسۡجُدُونَ﴾: لا يَخْضَعُونَ للهِ، ولا يُسَلِّمُونَ بِما جاءَ في القُرآنِ."}
{"src": "almuyassar-ghareeb", "s": 84, "a_start": 23, "a_end": 23, "data": "﴿بِمَا يُوعُونَ﴾: بِما يَكْتُمُونَ مِن العِنادِ مَعَ عِلْمِهِم بأنّ ما جاءَ بهِ القرآنُ حَقٌّ."}
{"src": "almuyassar-ghareeb", "s": 84, "a_start": 24, "a_end": 24, "data": "﴿فَبَشِّرۡهُم﴾: أي هَؤُلاءِ المكذِّبِينَ."}
{"src": "almuyassar-ghareeb", "s": 84, "a_start": 25, "a_end": 25, "data": "﴿غَيۡرُ مَمۡنُونِۭ﴾: غَيرُ مَقْطُوعٍ ولا مَنقُوصٍ."}
