{"src": "almuyassar-ghareeb", "s": 81, "a_start": 1, "a_end": 1, "data": "﴿كُوِّرَتۡ﴾: لُفَّتْ، وذَهَبَ ضَوْءُها."}
{"src": "almuyassar-ghareeb", "s": 81, "a_start": 2, "a_end": 2, "data": "﴿ٱنكَدَرَتۡ﴾: تَناثَرَتْ، فَذَهَبَ نُورُها."}
{"src": "almuyassar-ghareeb", "s": 81, "a_start": 3, "a_end": 3, "data": "﴿سُيِّرَتۡ﴾: سُيِّرَتْ عن وجْهِ الأرْضِ فَصارَتْ هَباءً."}
{"src": "almuyassar-ghareeb", "s": 81, "a_start": 4, "a_end": 4, "data": "﴿ٱلۡعِشَارُ﴾: النُوقُ الحوامِلُ.\n﴿عُطِّلَتۡ﴾: تُرِكَتْ وأُهْمِلَتْ."}
{"src": "almuyassar-ghareeb", "s": 81, "a_start": 5, "a_end": 5, "data": "﴿ٱلۡوُحُوشُ﴾: الحيواناتُ الوَحْشِيِّةُ.\n﴿حُشِرَتۡ﴾: جُمِعَتْ واخْتَلَطَتْ، لِيَقْتَصَّ اللهُ مِن بَعْضِها لِبَعْضٍ."}
{"src": "almuyassar-ghareeb", "s": 81, "a_start": 6, "a_end": 6, "data": "﴿سُجِّرَتۡ﴾: أُوقِدَتْ."}
{"src": "almuyassar-ghareeb", "s": 81, "a_start": 7, "a_end": 7, "data": "﴿زُوِّجَتۡ﴾: قُرِنَتْ بأَمثالِها."}
{"src": "almuyassar-ghareeb", "s": 81, "a_start": 8, "a_end": 8, "data": "﴿ٱلۡمَوۡءُۥدَةُ﴾: الطِّفْلةُ المدفُونةُ حَيَةً.\n﴿سُئِلَتۡ﴾: سُؤالَ تَطْيِيبٍ لها ولَومٍ لِوائِدِها."}
{"src": "almuyassar-ghareeb", "s": 81, "a_start": 10, "a_end": 10, "data": "﴿ٱلصُّحُفُ﴾: صُحُفُ الأَعْمالِ.\n﴿نُشِرَتۡ﴾: عُرِضَتْ."}
{"src": "almuyassar-ghareeb", "s": 81, "a_start": 11, "a_end": 11, "data": "﴿كُشِطَتۡ﴾: أُزِيلَتْ مِن مَّكانِها."}
{"src": "almuyassar-ghareeb", "s": 81, "a_start": 12, "a_end": 12, "data": "﴿سُعِّرَتۡ﴾: أُوقِدَتْ."}
{"src": "almuyassar-ghareeb", "s": 81, "a_start": 13, "a_end": 13, "data": "﴿أُزۡلِفَتۡ﴾: قُرِّبَتْ مِن أهْلِها."}
{"src": "almuyassar-ghareeb", "s": 81, "a_start": 14, "a_end": 14, "data": "﴿أَحۡضَرَتۡ﴾: قَدَّمَتْ من خَيرٍ أو شَرٍّ."}
{"src": "almuyassar-ghareeb", "s": 81, "a_start": 15, "a_end": 15, "data": "﴿بِٱلۡخُنَّسِ﴾: بِالنُّجُومِ المُخْتَفِيَةِ أنْوارُها نهارًا."}
{"src": "almuyassar-ghareeb", "s": 81, "a_start": 16, "a_end": 16, "data": "﴿ٱلۡجَوَارِ﴾: الجارِيةِ.\n﴿ٱلۡكُنَّسِ﴾: المسْتَتِرَةِ في أبْراجِها."}
{"src": "almuyassar-ghareeb", "s": 81, "a_start": 17, "a_end": 17, "data": "﴿عَسۡعَسَ﴾: أقْبَلَ بِظَلامِهِ."}
{"src": "almuyassar-ghareeb", "s": 81, "a_start": 18, "a_end": 18, "data": "﴿تَنَفَّسَ﴾: ظَهَرَ ضِياؤُه."}
{"src": "almuyassar-ghareeb", "s": 81, "a_start": 19, "a_end": 19, "data": "﴿إِنَّهُۥ﴾: إنَّ القُرآنَ.\n﴿رَسُولࣲ كَرِيمࣲ﴾: هو جِبْرِيلُ -عَلَيه السَّلامُ-."}
{"src": "almuyassar-ghareeb", "s": 81, "a_start": 20, "a_end": 20, "data": "﴿ذِي ٱلۡعَرۡشِ﴾: اللهِ.\n﴿مَكِينࣲ﴾: صاحبِ مَكانَةٍ رَفِيعَةٍ."}
{"src": "almuyassar-ghareeb", "s": 81, "a_start": 21, "a_end": 21, "data": "﴿ثَمَّ﴾: هُناكَ.\n﴿أَمِينࣲ﴾: مُؤْتَمَنٍ على الوَحْيِ الَّذِي يَنْزِلُ بِه."}
{"src": "almuyassar-ghareeb", "s": 81, "a_start": 22, "a_end": 22, "data": "﴿صَاحِبُكُم﴾: مُحَمَّدٌ ﷺ الَّذِي تَعْرِفُونَهُ."}
{"src": "almuyassar-ghareeb", "s": 81, "a_start": 23, "a_end": 23, "data": "﴿وَلَقَدۡ رَءَاهُ﴾: ولَقَدْ رَأى مُحَمَّدٌ جِبْرِيلَ.\n﴿بِٱلۡأُفُقِ ٱلۡمُبِينِ﴾: بالأُفُقِ العَظِيمِ."}
{"src": "almuyassar-ghareeb", "s": 81, "a_start": 24, "a_end": 24, "data": "﴿عَلَى ٱلۡغَيۡبِ﴾: بِتَبْلِيغ الوَحْيِ.\n﴿بِضَنِينࣲ﴾: ببَخِيلٍ."}
{"src": "almuyassar-ghareeb", "s": 81, "a_start": 25, "a_end": 25, "data": "﴿رَّجِيمࣲ﴾: مَطْرُودٍ منِ رَّحْمَةِ اللهِ."}
{"src": "almuyassar-ghareeb", "s": 81, "a_start": 26, "a_end": 26, "data": "﴿فَأَيۡنَ تَذۡهَبُونَ﴾: فَأَينَ تَذْهَبُ بِكُم عُقُولُكُم فَي التَّكْذِيبِ بالقُرآنِ بَعْدَ هذِه الحُجَجِ القاطِعَةِ؟"}
{"src": "almuyassar-ghareeb", "s": 81, "a_start": 27, "a_end": 27, "data": "﴿ذِكۡرࣱ﴾: مَوعِظَةٌ."}
{"src": "almuyassar-ghareeb", "s": 81, "a_start": 28, "a_end": 28, "data": "﴿يَسۡتَقِيمَ﴾: على الحقِّ والإيمانِ."}
