{"src": "almuyassar-ghareeb", "s": 52, "a_start": 1, "a_end": 1, "data": "﴿وَٱلطُّورِ﴾: هُوَ الجَبَلُ الَّذِي كَلَّمَ اللهُ عَلَيهِ مُوسى عَلَيهِ السَّلامُ."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 2, "a_end": 2, "data": "﴿مَّسۡطُورࣲ﴾: مَكْتُوبٍ، وهُو القُرآنُ."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 3, "a_end": 3, "data": "﴿فِي رَقࣲّ مَّنشُورࣲ﴾: مَكْتُوبٍ في صَحِيفةٍ مَبْسُوطَةٍ."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 4, "a_end": 4, "data": "﴿وَٱلۡبَيۡتِ ٱلۡمَعۡمُورِ﴾: هو فَوْقَ السَّماءِ السّابِعةِ تَطُوفُ بِه الملائِكةُ دائِمًا."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 5, "a_end": 5, "data": "﴿وَٱلسَّقۡفِ ٱلۡمَرۡفُوعِ﴾: هو السَّماءُ الدُّنيا، جَعَلَها اللهُ سَقْفًا للأرْضِ."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 6, "a_end": 6, "data": "﴿ٱلۡمَسۡجُورِ﴾: الممْلُوءِ بالمياهِ."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 8, "a_end": 8, "data": "﴿دَافِعࣲ﴾: مانِعٍ يَمْنَعُه حِينَ وقُوعِهِ."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 9, "a_end": 9, "data": "﴿تَمُورُ﴾: تَتَحرَّكُ وتَضْطَرِبُ."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 10, "a_end": 10, "data": "﴿وَتَسِيرُ﴾: تَزُولُ عَنْ أماكِنِها وتَسيرُ كَسَيرِ السَّحابِ."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 11, "a_end": 11, "data": "﴿فَوَيۡلࣱ﴾: فَهَلاكٌ."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 12, "a_end": 12, "data": "﴿فِي خَوۡضࣲ﴾: في انْدِفاعٍ في الكَلامِ الباطِلِ.\n﴿يَلۡعَبُونَ﴾: يَسْتَهْزِئُونَ."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 13, "a_end": 13, "data": "﴿يُدَعُّونَ﴾: يُدْفَعُونَ.\n﴿دَعًّا﴾: دَفْعًا بِعُنْفٍ ومهانَةٍ."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 16, "a_end": 16, "data": "﴿ٱصۡلَوۡهَا﴾: ادْخُلُوها واحْتَرِقُوا بِنارِها."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 18, "a_end": 18, "data": "﴿فَـٰكِهِينَ﴾: طَيِّبَةً أنْفُسُكُم مُتَمَتِّعِينَ عَلى وجْهِ السُّرِورِ."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 19, "a_end": 19, "data": "﴿هَنِيٓـَٔۢا﴾: أكْلًا وشُرْبًا هَنِيئًا أي سائِغًا."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 20, "a_end": 20, "data": "﴿مُتَّكِـِٔينَ﴾: جالِسِين عَلى وجْهِ التَّمَكُّن والرّاحةِ.\n﴿سُرُرࣲ﴾: جَمْعُ سَرِيرٍ وهو ما يُضْطَجَعُ عَلَيهِ، وهو مَجْلِسُ المنَعَّمِينَ.\n﴿مَّصۡفُوفَةࣲ﴾: مُتَقابِلَةٍ.\n﴿وَزَوَّجۡنَـٰهُم﴾: قَرَنّاهُم.\n﴿بِحُورٍ﴾: بِنِساءٍ شَدِيداتِ بَياضِ العَينِ وسَوادها.\n﴿عِينࣲ﴾: واسِعاتِ العُيونِ حِسانِهِنَّ."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 21, "a_end": 21, "data": "﴿وَمَآ أَلَتۡنَـٰهُم﴾: وما نَقَصْناهُم.\n﴿رَهِينࣱ﴾: مَحْبُوسٌ مقْرُونٌ."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 22, "a_end": 22, "data": "﴿وَأَمۡدَدۡنَـٰهُم﴾: وزِدْناهُم."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 23, "a_end": 23, "data": "﴿يَتَنَـٰزَعُونَ﴾: يَتَعاطَونَ، ويُناوِلُ بعضُهم بَعْضًا.\n﴿كَأۡسࣰا﴾: إناءً مَمْلُوءًا مِنَ الخَمْرِ.\n﴿لَغۡوࣱ﴾: كَلامٌ لا فائِدةَ فِيهِ.\n﴿تَأۡثِيمࣱ﴾: إثْمٌ ومَعْصِيَةٌ."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 24, "a_end": 24, "data": "﴿مَّكۡنُونࣱ﴾: مَصُونٌ في أصْدافِهِ."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 26, "a_end": 26, "data": "﴿مُشۡفِقِينَ﴾: خائِفِينَ مِن عَذابِ رَبِنا."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 27, "a_end": 27, "data": "﴿ٱلسَّمُومِ﴾: نارِ جَهَنَّمَ وحَرارَتِها."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 28, "a_end": 28, "data": "﴿ٱلۡبَرُّ﴾: المُحْسِنُ."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 29, "a_end": 29, "data": "﴿بِنِعۡمَتِ رَبِّكَ﴾: بمَنِّهِ ولُطْفِهِ.\n﴿بِكَاهِنࣲ﴾: يُخْبِرُ بالغَيبِ دُونَ عِلْمٍ."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 30, "a_end": 30, "data": "﴿نَّتَرَبَّصُ﴾: نَنْتَظِرُ.\n﴿رَيۡبَ ٱلۡمَنُونِ﴾: حوادِثَ الدَّهرِ فَيَمُوتُ."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 32, "a_end": 32, "data": "﴿أَحۡلَـٰمُهُم﴾: عُقُولُهم.\n﴿طَاغُونَ﴾: مُتَجاوِزُونَ الحدَّ."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 33, "a_end": 33, "data": "﴿تَقَوَّلَهُۥ﴾: اخْتَلَقَهُ."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 37, "a_end": 37, "data": "﴿ٱلۡمُصَۜيۡطِرُونَ﴾: المُتَسَلِّطُونَ."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 38, "a_end": 38, "data": "﴿سُلَّمࣱ﴾: دَرَجٌ ومَصْعَدٌ إلى السَّماءِ.\n﴿يَسۡتَمِعُونَ﴾: الكَلامَ الَّذِي يَجْرِي في السَّماءِ ويَسْتَرِقُونَهُ.\n﴿بِسُلۡطَـٰنࣲ﴾: بِحُجَّةٍ."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 40, "a_end": 40, "data": "﴿مَّغۡرَمࣲ﴾: غَرامةٍ مَطْلُوبَةٍ مِنهُم."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 42, "a_end": 42, "data": "﴿كَيۡدࣰا﴾: مَكْرًا.\n﴿ٱلۡمَكِيدُونَ﴾: يَعُودُ ضَرَرُ مَكْرِهِم عَلَيهِم."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 44, "a_end": 44, "data": "﴿كِسۡفࣰا﴾: قِطَعًا كِبارًا مِنَ العَذابِ.\n﴿مَّرۡكُومࣱ﴾: مُتَراكِمٌ بَعْضُهُ فَوْقَ بَعْضٍ."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 45, "a_end": 45, "data": "﴿فَذَرۡهُمۡ﴾: فَدَعْهُم.\n﴿يُصۡعَقُونَ﴾: يُهلَكُونَ، وهو يومُ القِيامَةِ."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 46, "a_end": 46, "data": "﴿لَا يُغۡنِي﴾: لا يَدْفَعُ."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 47, "a_end": 47, "data": "﴿عَذَابࣰا دُونَ ذَ ٰ⁠لِكَ﴾: مِنَ القَتْلِ والسَّبْيِ وعَذابِ القَبْرِ."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 48, "a_end": 48, "data": "﴿بِأَعۡيُنِنَا﴾: بِمَرْأىً مِنّا وحِفْظٍ واعْتِناءٍ.\n﴿حِينَ تَقُومُ﴾: إلى الصَّلاةِ، وحِينَ تَقُومُ مِنَ النَّومِ."}
{"src": "almuyassar-ghareeb", "s": 52, "a_start": 49, "a_end": 49, "data": "﴿وَإِدۡبَـٰرَ ٱلنُّجُومِ﴾: عِنْدَ صَلاةِ الصُّبْحِ حِينَ يُغَطِّي ضَوءُ الصُّبْحِ النُّجُومَ."}
