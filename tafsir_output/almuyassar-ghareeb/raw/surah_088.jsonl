{"src": "almuyassar-ghareeb", "s": 88, "a_start": 1, "a_end": 1, "data": "﴿هَلۡ﴾: قَدْ.\n﴿ٱلۡغَـٰشِيَةِ﴾: القِيامةِ الَّتِي تَغْشى النّاسَ بأهْوالِها."}
{"src": "almuyassar-ghareeb", "s": 88, "a_start": 2, "a_end": 2, "data": "﴿وُجُوهࣱ﴾: وُجُوهُ الكُفّارِ.\n﴿خَـٰشِعَةٌ﴾: ذَلِيلةٌ بالعذابِ."}
{"src": "almuyassar-ghareeb", "s": 88, "a_start": 3, "a_end": 3, "data": "﴿عَامِلَةࣱ﴾: مُجْهَدَةٌ بالعَمَلِ.\n﴿نَّاصِبَةࣱ﴾: مُتْعَبَةٌ."}
{"src": "almuyassar-ghareeb", "s": 88, "a_start": 4, "a_end": 4, "data": "﴿تَصۡلَىٰ﴾: تُقاسِي نارًا.\n﴿حَامِيَةࣰ﴾: شَدِيدَة التَّوَهُّجِ."}
{"src": "almuyassar-ghareeb", "s": 88, "a_start": 5, "a_end": 5, "data": "﴿ءَانِيَةࣲ﴾: بَلَغَتْ مُنْتَهى الحرارةِ."}
{"src": "almuyassar-ghareeb", "s": 88, "a_start": 6, "a_end": 6, "data": "﴿ضَرِيعࣲ﴾: نَبْتٍ ذي شَوْكٍ لاصِقٍ بالأرْضِ."}
{"src": "almuyassar-ghareeb", "s": 88, "a_start": 7, "a_end": 7, "data": "﴿وَلَا يُغۡنِي مِن جُوعࣲ﴾: ولا يَسُدُّ جُوعَهُ."}
{"src": "almuyassar-ghareeb", "s": 88, "a_start": 8, "a_end": 8, "data": "﴿وُجُوهࣱ﴾: وُجُوهُ المؤمِنينَ.\n﴿نَّاعِمَةࣱ﴾: ذاتُ نِعْمَةٍ وكَرامةٍ."}
{"src": "almuyassar-ghareeb", "s": 88, "a_start": 9, "a_end": 9, "data": "﴿لِّسَعۡيِهَا﴾: لِعَمَلِها الَّذِي عَمِلَتْهُ في الدُّنيا.\n﴿رَاضِيَةࣱ﴾: في الآخِرَةِ حِينَ أُعْطِيَتِ الجنَّةَ بِعَمَلِها."}
{"src": "almuyassar-ghareeb", "s": 88, "a_start": 10, "a_end": 10, "data": "﴿عَالِيَةࣲ﴾: رَفِيعةِ المكانِ والمكانةِ."}
{"src": "almuyassar-ghareeb", "s": 88, "a_start": 11, "a_end": 11, "data": "﴿لَـٰغِيَةࣰ﴾: كَلِمةَ لَغْوٍ."}
{"src": "almuyassar-ghareeb", "s": 88, "a_start": 12, "a_end": 12, "data": "﴿جَارِيَةࣱ﴾: تَتَدَفَّقُ مِياهُها."}
{"src": "almuyassar-ghareeb", "s": 88, "a_start": 14, "a_end": 14, "data": "﴿مَّوۡضُوعَةࣱ﴾: مُعَدَّةٌ للشّارِبِينَ."}
{"src": "almuyassar-ghareeb", "s": 88, "a_start": 15, "a_end": 15, "data": "﴿وَنَمَارِقُ﴾: ووَسائِدُ ومَرافِقُ.\n﴿مَصۡفُوفَةࣱ﴾: بَعضُها بِجَنبِ بَعْضٍ."}
{"src": "almuyassar-ghareeb", "s": 88, "a_start": 16, "a_end": 16, "data": "﴿وَزَرَابِيُّ﴾: وبُسُطٌ.\n﴿مَبۡثُوثَةٌ﴾: كَثِيرةٌ مَفْرُوشَةٌ."}
{"src": "almuyassar-ghareeb", "s": 88, "a_start": 18, "a_end": 18, "data": "﴿كَيۡفَ رُفِعَتۡ﴾: عَنِ الأرْضِ بِلا عَمَدٍ؟"}
{"src": "almuyassar-ghareeb", "s": 88, "a_start": 19, "a_end": 19, "data": "﴿نُصِبَتۡ﴾: رُفِعتْ حتّى كانتْ بارزةً على وجْهِ الأرضِ."}
{"src": "almuyassar-ghareeb", "s": 88, "a_start": 20, "a_end": 20, "data": "﴿سُطِحَتۡ﴾: بُسِطَتْ و مُهِّدتْ."}
{"src": "almuyassar-ghareeb", "s": 88, "a_start": 21, "a_end": 21, "data": "﴿فَذَكِّرۡ﴾: فَعِظْ.\n﴿مُذَكِّرࣱ﴾: واعِظٌ."}
{"src": "almuyassar-ghareeb", "s": 88, "a_start": 22, "a_end": 22, "data": "﴿بِمُصَيۡطِرٍ﴾: بِمُسَلَّطٍ، فَتُكْرِهَهُم على الإيمانِ."}
{"src": "almuyassar-ghareeb", "s": 88, "a_start": 23, "a_end": 23, "data": "﴿تَوَلَّىٰ﴾: أعْرَضَ وأصَرَّ عَلى الكُفْرِ."}
{"src": "almuyassar-ghareeb", "s": 88, "a_start": 24, "a_end": 24, "data": "﴿ٱلۡعَذَابَ ٱلۡأَكۡبَرَ﴾: النّارَ."}
{"src": "almuyassar-ghareeb", "s": 88, "a_start": 25, "a_end": 25, "data": "﴿إِيَابَهُمۡ﴾: مَرْجِعَهُم بَعْدَ الموتِ."}
{"src": "almuyassar-ghareeb", "s": 88, "a_start": 26, "a_end": 26, "data": "﴿حِسَابَهُم﴾: جَزاءَهُم."}
