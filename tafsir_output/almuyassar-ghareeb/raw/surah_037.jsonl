{"src": "almuyassar-ghareeb", "s": 37, "a_start": 1, "a_end": 1, "data": "﴿وَٱلصَّـٰٓفَّـٰتِ﴾: هي الملائِكَةُ التي تَصْطَفُّ في عِبادَتِها."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 2, "a_end": 2, "data": "﴿فَٱلزَّ ٰ⁠جِرَ ٰ⁠تِ﴾: هي الملائكةُ التي تَزْجُرُ السَّحابَ وتَسُوقُه."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 3, "a_end": 3, "data": "﴿ذِكۡرًا﴾: هو القرآنُ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 6, "a_end": 6, "data": "﴿ٱلۡكَوَاكِبِ﴾: النُّجُومِ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 7, "a_end": 7, "data": "﴿مَّارِدࣲ﴾: مُتَمَرِّدٍ خارجٍ عَنِ الطّاعةِ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 8, "a_end": 8, "data": "﴿وَيُقۡذَفُونَ﴾: ويُرجَمُونَ (بالشُّهُبِ)."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 9, "a_end": 9, "data": "﴿دُحُورࣰا﴾: إبْعادًا وطَرْدًا.\n﴿وَاصِبٌ﴾: دائمٌ لا يَنْقَطِعُ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 10, "a_end": 10, "data": "﴿خَطِفَ ٱلۡخَطۡفَةَ﴾: أي: اسْتَرَقَ السَّمْعَ خِلْسةً.\n﴿فَأَتۡبَعَهُۥ﴾: تَبِعَه ولحِقَه.\n﴿شِهَابࣱ ثَاقِبࣱ﴾: نَجْمٌ مُضِيءٌ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 11, "a_end": 11, "data": "﴿لَّازِبِۭ﴾: مُلْتَزِقٍ بَعْضُه ببَعْضٍ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 12, "a_end": 12, "data": "﴿وَيَسۡخَرُونَ﴾: يَسْتَهْزِئُونَ بِكَ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 14, "a_end": 14, "data": "﴿ءَايَةࣰ﴾: مُعْجِزَةً مِن مُّعْجِزاتِكَ.\n﴿يَسۡتَسۡخِرُونَ﴾: يبالِغُونَ في سُخْرِيَّتِهِم."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 18, "a_end": 18, "data": "﴿دَ ٰ⁠خِرُونَ﴾: أذِلّاءُ صاغِرُونَ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 19, "a_end": 19, "data": "﴿زَجۡرَةࣱ وَ ٰ⁠حِدَةࣱ﴾: نَفْخَةٌ واحِدَةٌ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 20, "a_end": 20, "data": "﴿يَـٰوَيۡلَنَا﴾: يا هَلاكَنا."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 21, "a_end": 21, "data": "﴿يَوۡمُ ٱلۡفَصۡلِ﴾: يومُ القضاءِ بَيْنَ الخَلْقِ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 22, "a_end": 22, "data": "﴿ٱحۡشُرُواْ﴾: اجْمَعُوا.\n﴿وَأَزۡوَ ٰ⁠جَهُمۡ﴾: قُرَناءَهُم ونُظراءَهُم."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 23, "a_end": 23, "data": "﴿فَٱهۡدُوهُمۡ إِلَىٰ صِرَ ٰ⁠طِ ٱلۡجَحِيمِ﴾: دُلُّوهُم إلى طَرِيقِ النّارِ، وسُوقُوهُم إليها."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 24, "a_end": 24, "data": "﴿وَقِفُوهُمۡ﴾: احْبِسُوهُم في مَوْقِفِ الحِسابِ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 26, "a_end": 26, "data": "﴿مُسۡتَسۡلِمُونَ﴾: مُنْقادُونَ أذلّاءُ لِعَجِزِهِم عَنِ الحِيلَةِ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 28, "a_end": 28, "data": "﴿عَنِ ٱلۡيَمِينِ﴾: أي: عَنِ النّاحيةِ الَّتي كان مِنها الحقُّ، فَتَصْرِفُونَنا عَنْها."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 30, "a_end": 30, "data": "﴿طَـٰغِينَ﴾: متجاوِزِينَ الحَدَّ في الكُفْرِ والضَّلالِ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 31, "a_end": 31, "data": "﴿فَحَقَّ﴾: ثَبَتَ ووَجَبَ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 32, "a_end": 32, "data": "﴿فَأَغۡوَيۡنَـٰكُمۡ﴾: فأَضْلَلْناكُم.\n﴿غَـٰوِينَ﴾: ضالِّيِنَ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 45, "a_end": 45, "data": "﴿يُطَافُ﴾: يُدارُ.\n﴿بِكَأۡسࣲ﴾: بِكأسٍ مِن خمْرٍ.\n﴿مَّعِينِۭ﴾: نابِعٍ مِنَ العُيوَنِ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 47, "a_end": 47, "data": "﴿لَا فِيهَا غَوۡلࣱ﴾: لا أذىً فيها ولا مَكْروهٌ على شاربيها.\n﴿وَلَا هُمۡ عَنۡهَا يُنزَفُونَ﴾: ولا هم عَن شُرْبِها تَذْهَبُ عُقُولُهم، أي: لا تُنزَفُ عُقُولُهم كما يُنْزَفَ دَمُ الجَرِيحِ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 48, "a_end": 48, "data": "﴿قَـٰصِرَ ٰ⁠تُ ٱلطَّرۡفِ﴾: حُورٌ قَصَرْنَ نَظَرَهُنَّ على أزْواجِهِنَّ.\n﴿عِينࣱ﴾: جَمْعُ «عَيناءَ»: واسعةُ العَينِ حَسَنَتُها."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 49, "a_end": 49, "data": "﴿مَّكۡنُونࣱ﴾: مَصُونٌ لم يَمْسَسْهُ أحَدٌ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 51, "a_end": 51, "data": "﴿قَرِينࣱ﴾: صاحِبٌ مُلازِمٌ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 53, "a_end": 53, "data": "﴿لَمَدِينُونَ﴾: لَمَجْزِيُّونَ ومُحاسَبُونَ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 55, "a_end": 55, "data": "﴿سَوَآءِ ٱلۡجَحِيمِ﴾: وسَطِها."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 56, "a_end": 56, "data": "﴿تَٱللَّهِ﴾: واللهِ.\n﴿كِدتَّ﴾: قارَبْتَ.\n﴿لَتُرۡدِينِ﴾: لَتُهْلِكُنِي."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 57, "a_end": 57, "data": "﴿ٱلۡمُحۡضَرِينَ﴾: أي: في العذابِ مِثلَك."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 62, "a_end": 62, "data": "﴿نُّزُلًا﴾: ما يُهَيَّأُ للنَّزيلِ إكْرامًا لهُ.\n﴿شَجَرَةُ ٱلزَّقُّومِ﴾: الشَّجَرَةُ الخَبيَثةُ الملعُونةُ ذاتُ الثَّمرِ المُرِّ الكرِيهِ الرّائِحَةِ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 63, "a_end": 63, "data": "﴿فِتۡنَةࣰ لِّلظَّـٰلِمِينَ﴾: مِحْنَةً لَهُم لِكَوْنِهِم يُعَذَّبُونَ بِها في الآخِرةِ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 64, "a_end": 64, "data": "﴿تَخۡرُجُ﴾: تَنْبُتُ.\n﴿أَصۡلِ ٱلۡجَحِيمِ﴾: قَعْرِ جَهَنَّمَ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 65, "a_end": 65, "data": "﴿طَلۡعُهَا﴾: ثَمَرُها.\n﴿كَأَنَّهُۥ رُءُوسُ ٱلشَّيَـٰطِينِ﴾: تشبيهٌ للمَحْسُوسِ بالمتَخَيَّلِ؛ لِتناهِيهِ في البَشاعَةِ والقُبْحِ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 67, "a_end": 67, "data": "﴿لَشَوۡبࣰا﴾: لخَلْطًا ومِزاجًا.\n﴿مِّنۡ حَمِيمࣲ﴾: الماءِ الحارِّ الشَّديدِ الحرارةِ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 68, "a_end": 68, "data": "﴿مَرۡجِعَهُمۡ﴾: مَرَدَّهُم.\n﴿ٱلۡجَحِيمِ﴾: جَهَنَّمَ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 69, "a_end": 69, "data": "﴿أَلۡفَوۡاْ﴾: وجَدُوا."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 70, "a_end": 70, "data": "﴿يُهۡرَعُونَ﴾: يُسْرِعُونَ إلى متابعةِ آبائِهِم الضّالِّينَ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 72, "a_end": 72, "data": "﴿مُّنذِرِينَ﴾: مُرسَلِينَ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 76, "a_end": 76, "data": "﴿ٱلۡكَرۡبِ ٱلۡعَظِيمِ﴾: الغَرَقِ بالطُّوفانِ العظيمِ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 78, "a_end": 78, "data": "﴿ٱلۡـَٔاخِرِينَ﴾: الَّذينَ جاؤُوا بَعْدَه."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 82, "a_end": 82, "data": "﴿ٱلۡـَٔاخَرِينَ﴾: الباقِينَ الَّذين كذَّبوُا نوحًا عليه الصَّلاةُ والسَّلامُ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 83, "a_end": 83, "data": "﴿شِيعَتِهِۦ﴾: أي: جَماعَتِهِ الَّذينَ هُمُ الأنبِياءُ والمرْسَلُونَ عليهم الصَّلاةُ والسَّلامُ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 86, "a_end": 86, "data": "﴿أَئِفۡكًا﴾: أكَذِبًا وباطِلًا."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 88, "a_end": 88, "data": "﴿فَنَظَرَ﴾: تَأَمَّلَ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 89, "a_end": 89, "data": "﴿سَقِيمࣱ﴾: مَرِيضٌ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 90, "a_end": 90, "data": "﴿فَتَوَلَّوۡاْ عَنۡهُ مُدۡبِرِينَ﴾: فانصَرَفُوا عنه مُعْرِضِين."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 91, "a_end": 91, "data": "﴿فَرَاغَ إِلَىٰٓ﴾: ذَهَبَ خُفْيَةً."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 93, "a_end": 93, "data": "﴿فَرَاغَ عَلَيۡهِمۡ﴾: مالَ وأَقْبَل عَلَيهِم.\n﴿بِٱلۡيَمِينِ﴾: أي: بيَدِه اليُمْنى."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 94, "a_end": 94, "data": "﴿يَزِفُّونَ﴾: يُسْرِعُونَ في مَشْيِهِم."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 95, "a_end": 95, "data": "﴿تَنۡحِتُونَ﴾: تَبْرُونَ وتَقْشِرُونَ بِأَيْدِيكُم."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 97, "a_end": 97, "data": "﴿ٱلۡجَحِيمِ﴾: النّارِ الشَّديدةِ الاتِّقادِ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 98, "a_end": 98, "data": "﴿ٱلۡأَسۡفَلِينَ﴾: المقْهُورِينَ المغْلُوبِينَ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 101, "a_end": 101, "data": "﴿حَلِيمࣲ﴾: أي: عِنْدَما يَكْبَر."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 103, "a_end": 103, "data": "﴿أَسۡلَمَا﴾: اسْتَسْلَما لأمْرِ اللهِ وانْقادا لَه.\n﴿وَتَلَّهُۥ لِلۡجَبِينِ﴾: أي: أضْجَعَه على جَبينِه على الأرضِ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 106, "a_end": 106, "data": "﴿ٱلۡبَلَـٰٓؤُاْ ٱلۡمُبِينُ﴾: الاخْتِبارُ الواضِحُ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 107, "a_end": 107, "data": "﴿بِذِبۡحٍ عَظِيمࣲ﴾: بكَبْشٍ مَذْبُوحٍ عَظِيمِ القَدْرِ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 108, "a_end": 108, "data": "﴿عَلَيۡهِ﴾: أي: على ذِكْرِه الحَسَنِ.\n﴿فِي ٱلۡـَٔاخِرِينَ﴾: في الأُمَمِ التي جاءتْ بَعْدَه."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 115, "a_end": 115, "data": "﴿مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ﴾: أي: مِنَ الغَرَقِ وتَسَلُّطِ فِرْعَونَ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 119, "a_end": 119, "data": "﴿عَلَيۡهِمَا﴾: أي: على ذِكْرِهِما الحَسَنِ.\n﴿فِي ٱلۡـَٔاخِرِينَ﴾: في الأمَمِ الَّتي جاءَتْ بَعْدَهُما."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 125, "a_end": 125, "data": "﴿بَعۡلࣰا﴾: وهو اسْمٌ لِصَنَمٍ كانُوا يَعْبُدُونَهُ.\n﴿وَتَذَرُونَ﴾: تَتْرُكُونَ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 127, "a_end": 127, "data": "﴿لَمُحۡضَرُونَ﴾: أي: لِلْحِسابِ والعِقابِ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 129, "a_end": 129, "data": "﴿عَلَيۡهِ﴾: أي: على ذِكْرِه الحَسَنِ.\n﴿فِي ٱلۡـَٔاخِرِينَ﴾: في الأُمَمِ الَّتي جاءَتْ بَعْدَهُ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 135, "a_end": 135, "data": "﴿فِي ٱلۡغَـٰبِرِينَ﴾: الباقِينَ في العذابِ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 136, "a_end": 136, "data": "﴿دَمَّرۡنَا﴾: أهْلَكْنا.\n﴿ٱلۡـَٔاخَرِينَ﴾: الباقِينَ مِن قَومِ لُوطٍ عَلَيهِ السَّلامُ الَّذينَ لم يُؤْمِنُوا بِهِ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 137, "a_end": 137, "data": "﴿مُّصۡبِحِينَ﴾: داخِلِينَ وقْتَ الصَّباحِ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 140, "a_end": 140, "data": "﴿أَبَقَ﴾: هَرَبَ.\n﴿ٱلۡمَشۡحُونِ﴾: المَمْلُوءِ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 141, "a_end": 141, "data": "﴿فَسَاهَمَ﴾: اقْتَرَعَ وقَبِلَ القُرْعَةَ.\n﴿ٱلۡمُدۡحَضِينَ﴾: المَغْلُوبِينَ بالقُرْعَةِ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 142, "a_end": 142, "data": "﴿فَٱلۡتَقَمَهُ﴾: فابْتَلَعَه.\n﴿مُلِيمࣱ﴾: آتٍ بما يُلامُ عَلَيهِ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 143, "a_end": 143, "data": "﴿ٱلۡمُسَبِّحِينَ﴾: بِذِكْرِ اللهِ وكَثْرةِ العِبادةِ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 144, "a_end": 144, "data": "﴿لَلَبِثَ﴾: لمَكَثَ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 145, "a_end": 145, "data": "﴿فَنَبَذۡنَـٰهُ﴾: طَرَحْناه.\n﴿بِٱلۡعَرَآءِ﴾: بِأرْضٍ خاليةٍ عاريةٍ من الشَّجرِ والبناءِ.\n﴿سَقِيمࣱ﴾: ضَعِيفُ البَدَنِ بسَبِبِ حَبْسِهِ في بَطْنِ الحُوتِ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 146, "a_end": 146, "data": "﴿يَقۡطِينࣲ﴾: القَرْعِ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 151, "a_end": 151, "data": "﴿إِفۡكِهِمۡ﴾: من كَذِبِهِم وافْتِرائِهِم."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 153, "a_end": 153, "data": "﴿أَصۡطَفَى﴾: هل اخْتارَ؟"}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 156, "a_end": 156, "data": "﴿سُلۡطَـٰنࣱ مُّبِينࣱ﴾: حُجَّةٌ واضِحةٌ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 158, "a_end": 158, "data": "﴿وَبَيۡنَ ٱلۡجِنَّةِ﴾: بَيْنَ الملائِكَةِ.\n﴿لَمُحۡضَرُونَ﴾: أي: لِلْعَذابِ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 162, "a_end": 162, "data": "﴿بِفَـٰتِنِينَ﴾: بمُضِلِّينَ ومُفْسِدِينَ أحَدًا."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 163, "a_end": 163, "data": "﴿صَالِ ٱلۡجَحِيمِ﴾: يَدْخُلُ النارَ، ويُقاسي حَرَّها."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 165, "a_end": 165, "data": "﴿ٱلصَّآفُّونَ﴾: الواقِفُونَ صُفُوفًا."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 166, "a_end": 166, "data": "﴿ٱلۡمُسَبِّحُونَ﴾: المُنَزِّهُونَ للهِ والمُقَدِّسُونَ له عَن كُلِّ ما لا يَلِيقُ بِه."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 168, "a_end": 168, "data": "﴿ذِكۡرࣰا مِّنَ ٱلۡأَوَّلِينَ﴾: أي: كِتابًا مِن كُتُبِ الأوَّلِينَ كالتَّوراةِ والإنْجِيلِ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 170, "a_end": 170, "data": "﴿فَكَفَرُواْ بِهِۦ﴾: أي: فَجاءَهُم الرَّسُولُ بالقرآنِ فَكَفَرُوا بِهِ."}
{"src": "almuyassar-ghareeb", "s": 37, "a_start": 177, "a_end": 177, "data": "﴿بِسَاحَتِهِمۡ﴾: بِفِنائِهِم، والمرادُ: القَومُ."}
